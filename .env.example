# Weather API Configuration
# Get your free API key from: https://www.weatherapi.com/
WEATHER_API_KEY=your_weatherapi_key_here

# Mindanao Cities
# Comma-separated list of cities to fetch weather data for
# You can add or remove cities as needed
MINDANAO_CITIES=Davao,Cagayan de Oro,Butuan,General Santos,Zamboanga,Cotabato,Iligan,Marawi,Tagum,Koronadal,Malaybalay,Dipolog,Pagadian,Tandag,Mati,Surigao,Ozamiz,Kidapawan,Digos,Gingoog